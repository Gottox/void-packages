# Template file for 'libsqsh'
pkgname=libsqsh
version=0.1.0
revision=1
build_style=meson
configure_args="-Dcurl=false"
makedepends="zlib-devel liblz4-devel liblzma-devel libzstd-devel fuse3-devel"
hostmakedepends="pkg-config"
short_desc="Fresh squashfs implementation"
maintainer="Enno Boland <gottox@voidlinux.org>"
license="BSD-2-Clause"
homepage="https://gottox.de/libsqsh"
distfiles="https://github.com/Gottox/libsqsh/archive/refs/tags/v${version}.tar.gz"
checksum=bdb2dc19247df238c7cf8d70c12ff0e126c4f637a900c9352e4fc6418b7963ad

post_install() {
	vlicense LICENSE
	find src -name '*.h' | while read -r f; do
		dest=${f#src/}
		mkdir -p "$DESTDIR/usr/include/libsqsh/$(dirname "$dest")"
		cp "$f" "$DESTDIR/usr/include/libsqsh/$desn"
	done
}

libsqsh-tools_package() {
	depends="gnutls-devel gtk+3-devel pcre2-devel vte3>=${version}_${revision}"
	short_desc+=" - tools"
	pkg_install() {
		vmove usr/bin
	}
}

libsqsh-devel_package() {
	depends="gnutls-devel gtk+3-devel pcre2-devel vte3>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		#vmove usr/lib/pkgconfig
		vmove "usr/lib/*.so"
		if [ "$build_option_gir" ]; then
			vmove usr/share/gir-1.0
			vmove usr/share/vala
		fi
	}
}
